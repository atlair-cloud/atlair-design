{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "$type": "color",
    "atlair": {
      "50": { "$value": "#f4f8fc" },
      "100": { "$value": "#e8f0f9" },
      "200": { "$value": "#d4e3f2" },
      "300": { "$value": "#b6cde6" },
      "400": { "$value": "#91b0d4" },
      "500": { "$value": "#7196c0" },
      "600": { "$value": "#587ba5" },
      "700": { "$value": "#48658a" },
      "800": { "$value": "#3e5572" },
      "900": { "$value": "#35475f" },
      "950": { "$value": "#243041" }
    },
    "atlair-dark": {
      "900": { "$value": "#d9dde1" },
      "950": { "$value": "#eef0f2" }
    },
    "puff": { "$value": "#5eb7e6" },
    "canvas": {
      "light": { "$value": "#ffffff" },
      "dark": { "$value": "#111315" }
    },
    "canvas-subtle": {
      "light": { "$value": "#e6e3dc" },
      "dark": { "$value": "#24272b" }
    },
    "surface": {
      "light": { "$value": "#ffffff" },
      "dark": { "$value": "#1a1d20" }
    },
    "frame": {
      "light": { "$value": "#e7e4df" },
      "dark": { "$value": "#18191c" }
    },
    "frame-chrome": {
      "light": { "$value": "#1c1917" },
      "dark": { "$value": "#ffffff" }
    },
    "text": {
      "body": { "$value": "#344256" }
    },
    "slate": {
      "50": { "$value": "#f8fafc" },
      "100": { "$value": "#f1f5f9" },
      "200": { "$value": "#e2e8f0" },
      "300": { "$value": "#cbd5e1" },
      "400": { "$value": "#7d8a9c" },
      "500": { "$value": "#56657a" },
      "600": { "$value": "#475569" },
      "700": { "$value": "#334155" },
      "800": { "$value": "#1e293b" },
      "900": { "$value": "#0f172a" },
      "950": { "$value": "#020617" }
    },
    "slate-dark": {
      "50": { "$value": "#1d2023" },
      "100": { "$value": "#24272b" },
      "200": { "$value": "#2e3237" },
      "300": { "$value": "#40454c" },
      "400": { "$value": "#737c87" },
      "500": { "$value": "#9aa3ad" },
      "600": { "$value": "#b3bac2" },
      "700": { "$value": "#cdd2d8" },
      "800": { "$value": "#e2e5e9" },
      "900": { "$value": "#f1f3f5" },
      "950": { "$value": "#f8f9fa" }
    },
    "status": {
      "live": { "$value": "#58b98a" },
      "active": { "$value": "#5eb7e6" },
      "attention": { "$value": "#f4c96b" },
      "error": {
        "light": { "$value": "#dc2626" },
        "dark": { "$value": "#f07a7a" }
      }
    },
    "skeleton-track": {
      "light": { "$value": "#f1f5f9" },
      "dark": { "$value": "#202327" }
    },
    "skeleton-glint": {
      "light": { "$value": "#fafbfd" },
      "dark": { "$value": "#2c3035" }
    },
    "scrim": {
      "light": { "$value": "#1c191766" },
      "dark": { "$value": "#000000b3" }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": { "$value": "0.25rem" },
    "switch": { "$value": "5px" },
    "switch-thumb": { "$value": "3px" }
  },
  "shadow": {
    "$type": "shadow",
    "shell-light": {
      "$value": [
        { "color": "#d6d2cc", "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "1px" },
        { "color": "#1c19170a", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" },
        { "color": "#1c19172e", "offsetX": "0px", "offsetY": "16px", "blur": "40px", "spread": "-20px" }
      ]
    },
    "shell-dark": {
      "$value": [
        { "color": "#ffffff14", "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "1px" },
        { "color": "#ffffff0a", "offsetX": "0px", "offsetY": "1px", "blur": "0px", "spread": "0px", "inset": true },
        { "color": "#000000b3", "offsetX": "0px", "offsetY": "24px", "blur": "56px", "spread": "-24px" }
      ]
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": { "$value": [0.2, 0, 0, 1] },
    "enter": { "$value": [0, 0, 0.2, 1] },
    "exit": { "$value": [0.4, 0, 1, 1] },
    "glide": { "$value": [0.2, 0.8, 0.2, 1] },
    "ease": { "$value": [0.25, 0.1, 0.25, 1] },
    "ease-in-out": { "$value": [0.42, 0, 0.58, 1] }
  },
  "duration": {
    "$type": "duration",
    "exit": { "$value": "120ms" },
    "enter": { "$value": "200ms" },
    "enter-delay": { "$value": "80ms" },
    "tab-fade": { "$value": "220ms" },
    "page-fade": { "$value": "260ms" },
    "tab-shift": { "$value": "280ms" },
    "fade": { "$value": "300ms" },
    "page-shift": { "$value": "340ms" },
    "progress": { "$value": "400ms" },
    "glint": { "$value": "1100ms" },
    "skeleton": { "$value": "1600ms" },
    "skeleton-card": { "$value": "1800ms" }
  },
  "font": {
    "$type": "fontFamily",
    "sans": {
      "$value": ["Spline Sans", "ui-sans-serif", "system-ui", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "sans-serif"]
    }
  }
}
